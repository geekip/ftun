# systemd 单元样例：Type=notify 由 ftun 直接写 NOTIFY_SOCKET（不依赖 libsystemd）。
# 退出码 0=正常停止，1=配置或启动失败，2=用法错误，3=运行时致命错误，4=看门狗触发；
# 2 与 0 不应重启。WatchdogSec 须大于 ftun 的 base.watchdog 心跳间隔（约为其 1/3）。
[Unit]
Description=FTUN
After=network.target

[Service]
Type=notify
ExecStart=/usr/local/bin/ftun run -c /etc/ftun/config.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
RestartPreventExitStatus=2
WatchdogSec=30s
TimeoutStopSec=15s
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
