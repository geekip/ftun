# systemd 单元样例：Type=notify 由 ftun 直接写 NOTIFY_SOCKET（不依赖 libsystemd）。
# 退出码 0=正常停止，1=配置或操作失败，2=用法错误，3=致命错误，4=看门狗触发，5=控制结果未知；
# 2 与 0 不应重启。WatchdogSec 须大于 ftun 的 base.watchdog 心跳间隔（约为其 1/3）。
# 服务可能没有HOME；在/etc/ftun/config.json中合入以下绝对路径：
# {"base":{"cache-file":"/var/lib/ftun/ftun.cache"},"log":{"output":"file","file":"/var/log/ftun/ftun.log"}}
[Unit]
Description=FTUN
After=network.target

[Service]
Type=notify
RuntimeDirectory=ftun
RuntimeDirectoryMode=0700
StateDirectory=ftun
StateDirectoryMode=0700
LogsDirectory=ftun
LogsDirectoryMode=0700
ExecStart=/usr/local/bin/ftun run -c /etc/ftun/config.json -p /run/ftun/ftun.pid
ExecReload=/usr/local/bin/ftun reload -p /run/ftun/ftun.pid --timeout 30
ExecStop=/usr/local/bin/ftun stop -p /run/ftun/ftun.pid --timeout 15
Restart=on-failure
RestartSec=2s
RestartPreventExitStatus=2
WatchdogSec=30s
TimeoutStopSec=20s
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
