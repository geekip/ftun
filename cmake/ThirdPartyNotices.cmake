# 告知内容只来自依赖锁；配置阶段和独立脚本模式使用相同生成入口。
if(NOT DEFINED FTUN_DEPENDENCY_LOCK OR NOT DEFINED FTUN_NOTICES_OUTPUT)
  message(FATAL_ERROR "FTUN_DEPENDENCY_LOCK and FTUN_NOTICES_OUTPUT are required")
endif()
function(ftun_notice_string output)
  string(JSON field_type ERROR_VARIABLE field_error TYPE "${ftun_notice_lock}" ${ARGN})
  if(field_error OR NOT field_type STREQUAL "STRING")
    message(FATAL_ERROR "Missing or invalid notice field: ${ARGN}")
  endif()
  string(JSON field_value GET "${ftun_notice_lock}" ${ARGN})
  if(field_value STREQUAL "")
    message(FATAL_ERROR "Empty notice field: ${ARGN}")
  endif()
  set(${output} "${field_value}" PARENT_SCOPE)
endfunction()

function(ftun_generate_notices)
  file(READ "${FTUN_DEPENDENCY_LOCK}" ftun_notice_lock)
  string(JSON ftun_notice_count LENGTH "${ftun_notice_lock}" dependencies)
  if(ftun_notice_count LESS 1)
    message(FATAL_ERROR "The dependency inventory must not be empty")
  endif()
  set(ftun_notice_text "# Third-party notices\n\nGenerated from third_party/LOCK.json. Do not edit this generated file.\n\nThis inventory describes the locked sources; optional components may be omitted\nfrom a build. Complete license texts for installed components accompany this file.\n")
  math(EXPR ftun_notice_last "${ftun_notice_count} - 1")
  foreach(index RANGE ${ftun_notice_last})
    foreach(field name source license selected_license license_file build_boundary notice)
      ftun_notice_string(${field} dependencies ${index} ${field})
    endforeach()
    string(APPEND ftun_notice_text "\n## ${name}\n\nSource: ${source}\n")
    foreach(field version revision archive_sha256)
      string(JSON field_type ERROR_VARIABLE field_error TYPE
        "${ftun_notice_lock}" dependencies ${index} ${field})
      if(NOT field_error)
        ftun_notice_string(value dependencies ${index} ${field})
        string(APPEND ftun_notice_text "\n${field}: `${value}`\n")
      endif()
    endforeach()
    string(APPEND ftun_notice_text
      "\nLicense: ${license}\n\nSelected distribution license: ${selected_license}\n\nRetained source license: `${license_file}`\n\nBuild boundary: ${build_boundary}\n\n${notice}\n")
    string(JSON patch_count LENGTH "${ftun_notice_lock}" dependencies ${index} local_patches)
    if(patch_count GREATER 0)
      math(EXPR patch_last "${patch_count} - 1")
      string(APPEND ftun_notice_text "\nLocal patches:\n")
      foreach(patch RANGE ${patch_last})
        ftun_notice_string(path dependencies ${index} local_patches ${patch} path)
        ftun_notice_string(description dependencies ${index} local_patches ${patch} description)
        string(APPEND ftun_notice_text "\n- `${path}`: ${description}\n")
      endforeach()
    endif()
  endforeach()
  string(JSON toolchain_type ERROR_VARIABLE toolchain_error TYPE
    "${ftun_notice_lock}" distribution_toolchain)
  if(NOT toolchain_error)
    foreach(field name version source notice)
      ftun_notice_string(toolchain_${field} distribution_toolchain ${field})
    endforeach()
    string(APPEND ftun_notice_text
      "\n## Optional distribution toolchain: ${toolchain_name} ${toolchain_version}\n\nSource: ${toolchain_source}\n\n${toolchain_notice}\n\nZig-built packages include LICENSE-Zig and the applicable LICENSE-musl-libc or LICENSE-MinGW-w64.\n")
  endif()
  # 校验完整份输入后再写入，失败不覆盖已有告知；内容不变时保持时间戳。
  if(EXISTS "${FTUN_NOTICES_OUTPUT}")
    file(READ "${FTUN_NOTICES_OUTPUT}" previous_notice)
    if(previous_notice STREQUAL ftun_notice_text)
      return()
    endif()
  endif()
  file(WRITE "${FTUN_NOTICES_OUTPUT}" "${ftun_notice_text}")
endfunction()

ftun_generate_notices()
