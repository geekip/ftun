# 官方 DLL 独立准备，禁止在 CMake 配置/编译期间下载或编译未签名驱动。
if(WIN32 AND FTUN_MODULE_TUN STREQUAL "BUILTIN")
  file(READ "${PROJECT_SOURCE_DIR}/third_party/LOCK.json" ftun_wintun_lock)
  string(JSON ftun_wintun_version GET "${ftun_wintun_lock}" wintun_runtime version)
  set(FTUN_WINTUN_DIR "${PROJECT_SOURCE_DIR}/build/deps/wintun-${ftun_wintun_version}"
    CACHE PATH "Directory prepared by tools/fetch_wintun.py")
  if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
    set(ftun_wintun_arch arm64)
  elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
    set(ftun_wintun_arch amd64)
  else()
    message(FATAL_ERROR "Wintun distribution is only configured for Windows amd64/arm64")
  endif()
  set(ftun_wintun_dll "${FTUN_WINTUN_DIR}/${ftun_wintun_arch}/wintun.dll")
  set(ftun_wintun_license "${FTUN_WINTUN_DIR}/LICENSE-Wintun-binaries")
  foreach(kind dll license)
    if(NOT EXISTS "${ftun_wintun_${kind}}")
      message(FATAL_ERROR "Official Wintun runtime is missing; run: python tools/fetch_wintun.py")
    endif()
    file(SHA256 "${ftun_wintun_${kind}}" actual)
    if(kind STREQUAL "dll")
      string(JSON expected GET "${ftun_wintun_lock}" wintun_runtime binaries ${ftun_wintun_arch} sha256)
    else()
      string(JSON expected GET "${ftun_wintun_lock}" wintun_runtime license_sha256)
    endif()
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Wintun ${kind} SHA256 mismatch")
    endif()
  endforeach()
  configure_file("${ftun_wintun_dll}" "${CMAKE_BINARY_DIR}/wintun.dll" COPYONLY)
  configure_file("${ftun_wintun_license}" "${CMAKE_BINARY_DIR}/LICENSE-Wintun-binaries" COPYONLY)
  install(FILES "${ftun_wintun_dll}" DESTINATION ${CMAKE_INSTALL_BINDIR})
  install(FILES third_party/wintun-api-LICENSE
    DESTINATION ${CMAKE_INSTALL_DATADIR}/doc/ftun RENAME LICENSE-Wintun-API)
  install(FILES "${ftun_wintun_license}" third_party/wintun/api/wintun.h
    DESTINATION ${CMAKE_INSTALL_DATADIR}/doc/ftun)
endif()
