# 只处理本构建安装清单；不递归删除安装前缀或用户文件。
if(NOT EXISTS "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
  message(FATAL_ERROR "No install manifest; nothing to uninstall")
endif()
file(STRINGS "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt" files)
foreach(installed IN LISTS files)
  set(path "$ENV{DESTDIR}${installed}")
  if(EXISTS "${path}" OR IS_SYMLINK "${path}")
    file(REMOVE "${path}")
    if(EXISTS "${path}" OR IS_SYMLINK "${path}")
      message(FATAL_ERROR "Could not uninstall ${path}")
    endif()
  endif()
endforeach()
