# Zig只作为固定目标的C交叉工具链；依赖仍来自本仓库锁定源码。
find_program(FTUN_ZIG NAMES zig HINTS "$ENV{FTUN_ZIG_DIR}" REQUIRED)
set(CMAKE_C_COMPILER "${FTUN_ZIG}" cc -target "${FTUN_ZIG_TARGET}")
set(CMAKE_ASM_COMPILER "${FTUN_ZIG}" cc -target "${FTUN_ZIG_TARGET}")
set(CMAKE_AR "${FTUN_ZIG}")
set(CMAKE_USER_MAKE_RULES_OVERRIDE "${CMAKE_CURRENT_LIST_DIR}/zig-rules.cmake")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
