# 使用单独构建目录；所有未来依赖必须来自同一目标 sysroot。
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(DEFINED ENV{FTUN_MUSL_CC})
  set(CMAKE_C_COMPILER "$ENV{FTUN_MUSL_CC}")
else()
  set(CMAKE_C_COMPILER x86_64-linux-musl-gcc)
endif()
if(DEFINED ENV{FTUN_MUSL_AR})
  set(CMAKE_C_COMPILER_AR "$ENV{FTUN_MUSL_AR}")
  set(CMAKE_AR "$ENV{FTUN_MUSL_AR}")
else()
  find_program(FTUN_MUSL_GCC_AR NAMES x86_64-linux-musl-gcc-ar gcc-ar REQUIRED)
  set(CMAKE_C_COMPILER_AR "${FTUN_MUSL_GCC_AR}")
  set(CMAKE_AR "${FTUN_MUSL_GCC_AR}")
endif()
if(DEFINED ENV{FTUN_MUSL_RANLIB})
  set(CMAKE_C_COMPILER_RANLIB "$ENV{FTUN_MUSL_RANLIB}")
  set(CMAKE_RANLIB "$ENV{FTUN_MUSL_RANLIB}")
else()
  find_program(FTUN_MUSL_GCC_RANLIB
    NAMES x86_64-linux-musl-gcc-ranlib gcc-ranlib REQUIRED)
  set(CMAKE_C_COMPILER_RANLIB "${FTUN_MUSL_GCC_RANLIB}")
  set(CMAKE_RANLIB "${FTUN_MUSL_GCC_RANLIB}")
endif()
if(DEFINED ENV{FTUN_MUSL_SYSROOT})
  set(CMAKE_SYSROOT "$ENV{FTUN_MUSL_SYSROOT}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
