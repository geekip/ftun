include(GNUInstallDirs)
include(CTest)
find_package(Threads REQUIRED)
set(CMAKE_C_STANDARD 99)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_C_EXTENSIONS OFF)
include(CheckCSourceCompiles)
set(ftun_atomic_probe "#include <stdint.h>
int main(void) {
  uint64_t value = 0, expected = 0;
  __atomic_store_n(&value, 1, __ATOMIC_RELEASE);
  __atomic_fetch_add(&value, 1, __ATOMIC_RELAXED);
  __atomic_compare_exchange_n(&value, &expected, 3, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
  return (int)__atomic_load_n(&value, __ATOMIC_ACQUIRE);
}")
check_c_source_compiles("${ftun_atomic_probe}" FTUN_HAVE_COMPILER_ATOMICS)
if(NOT FTUN_HAVE_COMPILER_ATOMICS)
  set(CMAKE_REQUIRED_LIBRARIES atomic)
  check_c_source_compiles("${ftun_atomic_probe}" FTUN_HAVE_LIBATOMIC)
  unset(CMAKE_REQUIRED_LIBRARIES)
  if(NOT FTUN_HAVE_LIBATOMIC)
    message(FATAL_ERROR "FTUN requires compiler atomic operations")
  endif()
endif()
option(FTUN_SANITIZERS "Enable address and undefined behavior checks" OFF)
option(FTUN_TSAN "Enable thread sanitizer checks" OFF)
option(FTUN_FUZZ "Build libFuzzer targets (clang only; combine with FTUN_SANITIZERS)" OFF)
option(FTUN_LTO "Require supported interprocedural optimization" OFF)
option(FTUN_SECTION_GC "Remove unused code and data on supported toolchains" ON)
option(FTUN_STATIC "Build fully static Linux executables" OFF)
option(FTUN_HARDENING "Enable supported compiler and ELF hardening" ON)
set(FTUN_MODULE_PROXY "BUILTIN" CACHE STRING "Build the Proxy module: OFF or BUILTIN")
set(FTUN_MODULE_DNS "OFF" CACHE STRING "Build the DNS module: OFF or BUILTIN")
set(FTUN_MODULE_FAKEIP "OFF" CACHE STRING "Build the FakeIP module: OFF or BUILTIN")
set(FTUN_MODULE_TUN "OFF" CACHE STRING "Build the TUN module: OFF or BUILTIN")
set(FTUN_MODULE_FRS "OFF" CACHE STRING "Build the FRS module: OFF or BUILTIN")
set_property(CACHE FTUN_MODULE_PROXY PROPERTY STRINGS OFF BUILTIN)
set_property(CACHE FTUN_MODULE_DNS PROPERTY STRINGS OFF BUILTIN)
set_property(CACHE FTUN_MODULE_FAKEIP PROPERTY STRINGS OFF BUILTIN)
set_property(CACHE FTUN_MODULE_TUN PROPERTY STRINGS OFF BUILTIN)
set_property(CACHE FTUN_MODULE_FRS PROPERTY STRINGS OFF BUILTIN)
set(FTUN_OPTIMIZATION "balanced" CACHE STRING "balanced, speed or size")
set_property(CACHE FTUN_OPTIMIZATION PROPERTY STRINGS balanced speed size)
set(FTUN_EXTRA_COMPILE_OPTIONS "" CACHE STRING "Additional target options as a CMake list")
set(FTUN_EXTRA_LINK_OPTIONS "" CACHE STRING "Additional target link options as a CMake list")
set(FTUN_SOURCE_REVISION_OVERRIDE "" CACHE STRING
  "Override the source revision embedded in ftun version output")
set(ftun_source_revision "unknown")
if(NOT FTUN_SOURCE_REVISION_OVERRIDE STREQUAL "")
  set(ftun_source_revision "${FTUN_SOURCE_REVISION_OVERRIDE}")
else()
  find_package(Git QUIET)
  if(GIT_FOUND AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/.git")
    execute_process(
      COMMAND ${GIT_EXECUTABLE} rev-parse --short=12 HEAD
      WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
      RESULT_VARIABLE ftun_revision_result
      OUTPUT_VARIABLE ftun_revision_output
      OUTPUT_STRIP_TRAILING_WHITESPACE
      ERROR_QUIET)
    execute_process(
      COMMAND ${GIT_EXECUTABLE} status --porcelain --untracked-files=normal
      WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
      RESULT_VARIABLE ftun_status_result
      OUTPUT_VARIABLE ftun_status_output
      OUTPUT_STRIP_TRAILING_WHITESPACE
      ERROR_QUIET)
    if(ftun_revision_result EQUAL 0 AND NOT ftun_revision_output STREQUAL "")
      set(ftun_source_revision "${ftun_revision_output}")
      if(ftun_status_result EQUAL 0 AND NOT ftun_status_output STREQUAL "")
        string(APPEND ftun_source_revision "-dirty")
      endif()
    endif()
  endif()
endif()
if(NOT FTUN_OPTIMIZATION MATCHES "^(balanced|speed|size)$")
  message(FATAL_ERROR "Unsupported FTUN_OPTIMIZATION")
endif()
foreach(ftun_module PROXY DNS FAKEIP TUN FRS)
  if(NOT FTUN_MODULE_${ftun_module} MATCHES "^(OFF|BUILTIN)$")
    message(FATAL_ERROR
      "FTUN_MODULE_${ftun_module} must be OFF or BUILTIN; dynamic modules are not supported")
  endif()
endforeach()
if(FTUN_MODULE_FAKEIP STREQUAL "BUILTIN" AND
   (NOT FTUN_MODULE_DNS STREQUAL "BUILTIN" OR
    NOT FTUN_MODULE_PROXY STREQUAL "BUILTIN"))
  message(FATAL_ERROR
    "FTUN_MODULE_FAKEIP=BUILTIN requires FTUN_MODULE_PROXY=BUILTIN and FTUN_MODULE_DNS=BUILTIN")
endif()
if(FTUN_MODULE_FRS STREQUAL "BUILTIN" AND
   NOT FTUN_MODULE_PROXY STREQUAL "BUILTIN")
  message(FATAL_ERROR "FTUN_MODULE_FRS=BUILTIN requires FTUN_MODULE_PROXY=BUILTIN")
endif()
if(FTUN_MODULE_TUN STREQUAL "BUILTIN" AND NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT WIN32)
  message(FATAL_ERROR "FTUN_MODULE_TUN=BUILTIN requires a Linux or Windows target")
endif()
if(FTUN_STATIC AND NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
  message(FATAL_ERROR "FTUN_STATIC requires a Linux target toolchain")
endif()
if(FTUN_STATIC AND (FTUN_SANITIZERS OR FTUN_TSAN))
  message(FATAL_ERROR "Full-static and sanitizer builds are separate supported profiles")
endif()
if(FTUN_SANITIZERS AND FTUN_TSAN)
  message(FATAL_ERROR "Address and thread sanitizers cannot be combined")
endif()
# 供各目标共用：-fsanitize= 的取值。
if(FTUN_TSAN)
  set(FTUN_SANITIZE_KINDS "thread")
else()
  set(FTUN_SANITIZE_KINDS "address,undefined")
endif()
add_library(ftun_options INTERFACE)
if(WIN32)
  target_compile_definitions(ftun_options INTERFACE WIN32_LEAN_AND_MEAN NOMINMAX _WIN32_WINNT=0x0a00 NTDDI_VERSION=0x0A000006)
  target_link_options(ftun_options INTERFACE "LINKER:--dynamicbase" "LINKER:--nxcompat")
endif()
set(ftun_hardening_codegen_options)
set(ftun_hardening_compile_definitions)
if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
  target_compile_options(ftun_options INTERFACE -Wall -Wextra -Wvla -fno-strict-aliasing)
  if(FTUN_OPTIMIZATION STREQUAL "speed")
    set(ftun_opt -O3)
  elseif(FTUN_OPTIMIZATION STREQUAL "size")
    set(ftun_opt -Os)
  else()
    set(ftun_opt -O2)
  endif()
  target_compile_options(ftun_options INTERFACE
    "$<$<CONFIG:Debug>:-O0;-g>" "$<$<NOT:$<CONFIG:Debug>>:${ftun_opt}>")
  target_link_options(ftun_options INTERFACE "$<$<NOT:$<CONFIG:Debug>>:${ftun_opt}>")
  target_compile_definitions(ftun_options INTERFACE "$<$<NOT:$<CONFIG:Debug>>:NDEBUG>")
  if(FTUN_HARDENING)
    include(CheckCCompilerFlag)
    include(CheckLinkerFlag)
    check_c_compiler_flag("-fstack-protector-strong"
      FTUN_HAVE_STACK_PROTECTOR_STRONG)
    if(NOT FTUN_HAVE_STACK_PROTECTOR_STRONG)
      message(FATAL_ERROR "FTUN_HARDENING requires -fstack-protector-strong")
    endif()
    list(APPEND ftun_hardening_codegen_options -fstack-protector-strong)
    check_c_compiler_flag("-Werror -fstack-clash-protection"
      FTUN_HAVE_STACK_CLASH_PROTECTION)
    if(FTUN_HAVE_STACK_CLASH_PROTECTION)
      list(APPEND ftun_hardening_codegen_options -fstack-clash-protection)
    endif()
    list(APPEND ftun_hardening_compile_definitions
      "$<$<NOT:$<CONFIG:Debug>>:_FORTIFY_SOURCE=3>")
    target_compile_options(ftun_options INTERFACE
      -Wformat=2 -Wformat-security -Werror=format-security)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
      check_c_compiler_flag("-fPIE" FTUN_HAVE_PIE)
      if(NOT FTUN_HAVE_PIE)
        message(FATAL_ERROR "FTUN_HARDENING requires -fPIE on Linux")
      endif()
      list(APPEND ftun_hardening_codegen_options -fPIE)
      if(FTUN_STATIC)
        check_linker_flag(C "-static-pie" FTUN_HAVE_STATIC_PIE)
        if(NOT FTUN_HAVE_STATIC_PIE)
          message(FATAL_ERROR "FTUN_HARDENING requires -static-pie for FTUN_STATIC")
        endif()
        target_link_options(ftun_options INTERFACE -static-pie)
        if(DEFINED FTUN_ZIG)
          # Zig 0.15.2仅收到-static-pie时仍生成ET_EXEC，显式-pie才启用重定位。
          target_link_options(ftun_options INTERFACE -pie)
        endif()
      else()
        check_linker_flag(C "-pie" FTUN_HAVE_DYNAMIC_PIE)
        if(NOT FTUN_HAVE_DYNAMIC_PIE)
          message(FATAL_ERROR "FTUN_HARDENING requires -pie on Linux")
        endif()
        target_link_options(ftun_options INTERFACE -pie)
      endif()
      target_link_options(ftun_options INTERFACE
        "LINKER:-z,relro" "LINKER:-z,now" "LINKER:-z,noexecstack")
    endif()
    target_compile_options(ftun_options INTERFACE
      ${ftun_hardening_codegen_options})
    target_compile_definitions(ftun_options INTERFACE
      ${ftun_hardening_compile_definitions})
  endif()
  if(FTUN_SECTION_GC)
    target_compile_options(ftun_options INTERFACE -ffunction-sections -fdata-sections)
    if(APPLE)
      target_link_options(ftun_options INTERFACE "LINKER:-dead_strip")
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR WIN32)
      target_link_options(ftun_options INTERFACE "LINKER:--gc-sections")
    else()
      message(FATAL_ERROR "Section GC has not been defined for this target")
    endif()
  endif()
  if(FTUN_SANITIZERS OR FTUN_TSAN)
    target_compile_options(ftun_options INTERFACE -fsanitize=${FTUN_SANITIZE_KINDS} -fno-omit-frame-pointer)
    target_link_options(ftun_options INTERFACE -fsanitize=${FTUN_SANITIZE_KINDS})
  endif()
  if(FTUN_SANITIZERS)
    target_compile_options(ftun_options INTERFACE -Wconversion -Wsign-conversion)
  endif()
  if(FTUN_FUZZ)
    if(NOT CMAKE_C_COMPILER_ID STREQUAL "Clang")
      message(FATAL_ERROR "FTUN_FUZZ requires clang (libFuzzer)")
    endif()
    # 库代码带覆盖率插桩（不链接 libFuzzer 运行时，由 fuzzer 目标链接）。
    target_compile_options(ftun_options INTERFACE -fsanitize=fuzzer-no-link)
  endif()
  if(FTUN_TSAN)
    # wolfSSL 头文件里的内联内存屏障（atomic_thread_fence）会让 GCC 的 TSan 报 -Wtsan，
    # 包含这些头文件的目标都会遇到；TSan 不建模屏障，告警不当作错误。
    target_compile_options(ftun_options INTERFACE -Wno-tsan)
  endif()
else()
  if(FTUN_SANITIZERS OR FTUN_TSAN OR FTUN_SECTION_GC OR FTUN_HARDENING)
    message(FATAL_ERROR "Requested compiler options have not been defined for this compiler")
  endif()
endif()
target_compile_options(ftun_options INTERFACE ${FTUN_EXTRA_COMPILE_OPTIONS})
target_link_options(ftun_options INTERFACE ${FTUN_EXTRA_LINK_OPTIONS})
if(FTUN_STATIC)
  # Every first-party executable in the full-static profile, including its
  # verification binaries, must close over the same musl ABI.
  if(NOT FTUN_HARDENING)
    target_link_options(ftun_options INTERFACE -static)
  endif()
endif()
if(FTUN_LTO)
  include(CheckIPOSupported)
  check_ipo_supported(RESULT ftun_ipo_ok OUTPUT ftun_ipo_error LANGUAGES C)
  if(NOT ftun_ipo_ok)
    message(FATAL_ERROR "Requested LTO is unavailable: ${ftun_ipo_error}")
  endif()
endif()


set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
