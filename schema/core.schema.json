{
  "$defs": {
    "Name": {
      "type": "string",
      "pattern": "^(?:[^,\\u0000-\\u001f\\u007f]+)(?![\\s\\S])",
      "minLength": 1,
      "description": "区分大小写的名称。可以使用中文和空格；不得含逗号或控制字符。名称唯一性及引用由运行时检查。"
    },
    "OutboundName": {
      "$ref": "#/$defs/Name",
      "not": {
        "enum": [
          "DIRECT",
          "REJECT"
        ]
      },
      "description": "自定义出站/组名称，不可重定义内置 DIRECT 或 REJECT。"
    },
    "OptionalDNSName": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/$defs/Name"
        }
      ],
      "default": "",
      "description": "空值或省略按所在字段的缺省规则选择解析器；DNS 总开关关闭时忽略该引用。"
    },
    "Path": {
      "type": "string",
      "pattern": "^(?:[^\\u0000]+)(?![\\s\\S])",
      "minLength": 1,
      "description": "本地路径；~ 展开当前用户目录，相对路径以配置文件目录为基准。Schema 不检查文件存在性或权限。"
    },
    "IPv4": {
      "type": "string",
      "pattern": "^(?:(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])(?:\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])){3})(?![\\s\\S])",
      "description": "IPv4 点分十进制地址，不使用前导零。"
    },
    "IPv4CIDR": {
      "type": "string",
      "pattern": "^(?:(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])(?:\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])){3}/(?:[0-9]|[12][0-9]|3[0-2]))(?![\\s\\S])",
      "description": "IPv4 地址/前缀，前缀 0–32；网络地址规范化、地址冲突及用途检查由运行时执行。",
      "examples": [
        "10.0.0.0/8"
      ]
    },
    "ListenAddress": {
      "type": "string",
      "pattern": "^(?:(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])(?:\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])){3}:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))(?![\\s\\S])",
      "description": "IPv4:port，端口 1–65535；不接受域名或 IPv6 监听地址。",
      "examples": [
        "127.0.0.1:10808"
      ]
    },
    "BootstrapAddress": {
      "type": "string",
      "pattern": "^(?:(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])(?:\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])){3}(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?)(?![\\s\\S])",
      "description": "Bootstrap 仅接受 IPv4 或 IPv4:port，默认端口 53；始终真实直连解析。"
    },
    "ServerAddress": {
      "type": "string",
      "pattern": "^(?:(?:(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])(?:\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])){3}|(?=[A-Za-z0-9.-]{1,253}\\.?(?=[:/?#]|(?![\\s\\S])))(?![0-9]+(?:\\.[0-9]+){3}\\.?(?=[:/?#]|(?![\\s\\S])))(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))(?![\\s\\S])",
      "description": "IPv4/ASCII 域名:port。域名使用 ASCII A-label；端口 1–65535。",
      "examples": [
        "proxy.example.com:1080"
      ]
    },
    "DNSAddress": {
      "type": "string",
      "pattern": "^(?:(?:(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])(?:\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])){3}|(?=[A-Za-z0-9.-]{1,253}\\.?(?=[:/?#]|(?![\\s\\S])))(?![0-9]+(?:\\.[0-9]+){3}\\.?(?=[:/?#]|(?![\\s\\S])))(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?)(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?)(?![\\s\\S])",
      "description": "IPv4/ASCII 域名及可选端口，默认 53。上游域名由 Bootstrap 解析。",
      "examples": [
        "192.0.2.53",
        "dns.example.com:53"
      ]
    },
    "Duration": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:ms|s|m|h))(?![\\s\\S])",
      "description": "正整数与 ms/s/m/h 单位，不接受 0、负数、小数或无单位；整数溢出及字段之间的大小关系由运行时检查。",
      "examples": [
        "500ms",
        "5s",
        "5m",
        "24h"
      ]
    },
    "HTTPURL": {
      "type": "string",
      "pattern": "^(?:https?://(?:(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])(?:\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])){3}|(?=[A-Za-z0-9.-]{1,253}\\.?(?=[:/?#]|(?![\\s\\S])))(?![0-9]+(?:\\.[0-9]+){3}\\.?(?=[:/?#]|(?![\\s\\S])))(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?)(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\s]*)?)(?![\\s\\S])",
      "format": "uri",
      "description": "HTTP/HTTPS URL，IPv4 或 ASCII 域名主机；HTTPS 必须验证证书和主机名。",
      "examples": [
        "https://probe.example.invalid/generate_204"
      ]
    },
    "Credential": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "SOCKS5 认证值；Schema 限制字符数，运行时还须验证 UTF-8 编码后为 1–255 字节。"
    },
    "Users": {
      "title": "入站用户",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/Credential"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Credential",
        "writeOnly": true
      },
      "default": {},
      "description": "用户名到密码的映射。空对象表示无需认证；非空时必须认证。密码不得输出到日志。"
    }
  }
}
