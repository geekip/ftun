        "udp-flows" :
        {
          "default" : 256,
          "description" : "\u540c\u65f6\u5b58\u6d3b\u7684 UDP \u4e94\u5143\u7ec4\u6d41\u4e0a\u9650\uff1b\u4ec5\u542f\u52a8\u65f6\u751f\u6548\u3002",
          "maximum" : 10000,
          "minimum" : 1,
          "type" : "integer"
        }
      },
      "title" : "\u8fd0\u884c\u5bb9\u91cf",
      "type" : "object"
