    "BootstrapAddress" :
    {
      "description" : "IPv4 \u6216 [IPv6]\uff0c\u53ef\u5e26\u7aef\u53e3\uff0c\u9ed8\u8ba4 53\uff1b\u59cb\u7ec8\u771f\u5b9e\u76f4\u8fde\u89e3\u6790\u3002",
      "pattern" : "^(?:(?:(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])(?:\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])){3}(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?)(?![\\s\\S])|\\[(?=[0-9A-Fa-f:.]*:)[0-9A-Fa-f:.]{2,45}\\](?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?)(?![\\s\\S])",
      "type" : "string"
