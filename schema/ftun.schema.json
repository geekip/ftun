      "minLength" : 1,
      "type" : "string"
    },
    "DNS" :
    {
      "additionalProperties" : false,
      "description" : "\u5173\u95ed\u540e\u4ecd\u68c0\u67e5\u5b57\u6bb5\u5f62\u72b6\u548c\u8bed\u6cd5\uff0c\u4f46\u4e0d\u5efa\u7acb\u5931\u6548 DNS \u5f15\u7528\u6216\u8d44\u6e90\u4f9d\u8d56\u3002",
      "properties" :
      {
        "bootstrap" :
        {
          "default" : [],
