        "cache" :
        {
          "default" : true,
          "description" : "\u7f13\u5b58\u771f\u5b9e\u7b54\u6848\uff1b\u4e0d\u63a7\u5236 FakeIP \u8eab\u4efd\u5bff\u547d\u3002",
          "type" : "boolean"
        },
        "default-server" :
        {
          "$ref" : "#/$defs/OptionalDNSName",
          "description" : "\u9ed8\u8ba4\u670d\u52a1\u53ca\u8def\u7531\u524d REAL \u89e3\u6790\u5668\uff1b\u7a7a\u503c/\u7701\u7565\u4e3a Bootstrap\u3002"
        },
        "enable" :
        {
          "default" : true,
          "description" : "false \u65f6\u505c\u7528 FTUN DNS \u5165\u53e3\u3001\u7f13\u5b58\u3001Hijack \u4e0e FakeIP\uff1b\u5fc5\u8981\u672c\u5730\u89e3\u6790\u4f7f\u7528\u7cfb\u7edf\u89e3\u6790\u5668\u3002",
          "type" : "boolean"
