    "DNSAddress" :
    {
      "description" : "IPv4\u3001[IPv6] \u6216 ASCII \u57df\u540d\uff0c\u53ef\u5e26\u7aef\u53e3\uff0c\u9ed8\u8ba4 53\uff1b\u4e0a\u6e38\u57df\u540d\u7531 Bootstrap \u89e3\u6790\u3002",
      "examples" : [ "192.0.2.53", "dns.example.com:53" ],
      "pattern" : "^(?:(?:(?:(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])(?:\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])){3}|(?=[A-Za-z0-9.-]{1,253}\\.?(?=[:/?#]|(?![\\s\\S])))(?![0-9]+(?:\\.[0-9]+){3}\\.?(?=[:/?#]|(?![\\s\\S])))(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?)(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?)(?![\\s\\S])|\\[(?=[0-9A-Fa-f:.]*:)[0-9A-Fa-f:.]{2,45}\\](?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?)(?![\\s\\S])",
      "type" : "string"
    },
