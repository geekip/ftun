        {
          "default" : false,
          "description" : "\u5ba2\u6237\u7aef\u56de\u7b54\u7b56\u7565\uff1b\u5185\u90e8 REAL \u67e5\u8be2\u4ecd\u901a\u8fc7 address/outbound \u83b7\u53d6\u771f\u5b9e\u5730\u5740\u3002",
          "type" : "boolean"
        },
        "name" :
        {
          "$ref" : "#/$defs/Name"
        },
        "outbound" :
        {
          "$ref" : "#/$defs/Name",
          "default" : "DIRECT",
          "description" : "\u53ea\u51b3\u5b9a DNS \u67e5\u8be2\u7684\u4f20\u8f93\u8def\u5f84\uff0c\u4e0d\u51b3\u5b9a\u67e5\u8be2\u57df\u540d\u7684\u4e1a\u52a1\u51fa\u53e3\u3002"
        },
        "type" :
        {
          "description" : "v1 \u4ec5\u652f\u6301 UDP/TCP DNS\u3002",
          "enum" : [ "udp", "tcp" ],
          "type" : "string"
        }
      },
      "required" : [ "name", "type", "address" ],
      "title" : "DNS \u4e0a\u6e38\u4e0e\u56de\u7b54\u7b56\u7565",
      "type" : "object"
    },
    "DomainKeywordRule" :
    {
      "description" : "ASCII \u57df\u540d\u5b50\u4e32\uff0c\u65e0\u6b63\u5219\u89e3\u91ca\u3002",
      "examples" : [ "DOMAIN-KEYWORD,example,proxy" ],
      "pattern" : "^(?:[Dd][Oo][Mm][Aa][Ii][Nn]-[Kk][Ee][Yy][Ww][Oo][Rr][Dd],[\\x21-\\x2b\\x2d-\\x7e]+,[^,\\u0000-\\u001f\\u007f]+)(?![\\s\\S])",
      "title" : "DomainKeywordRule",
      "type" : "string"
    },
    "DomainRule" :
    {
      "description" : "\u5b8c\u6574\u57df\u540d\u5339\u914d\uff1bASCII A-label\u3002",
      "examples" : [ "DOMAIN,a.com,proxy" ],
      "pattern" : "^(?:[Dd][Oo][Mm][Aa][Ii][Nn],(?=[A-Za-z0-9.-]{1,253}\\.?,)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?,[^,\\u0000-\\u001f\\u007f]+)(?![\\s\\S])",
      "title" : "DomainRule",
      "type" : "string"
    },
    "DomainSuffixRule" :
    {
      "description" : "\u672c\u57df\u53ca\u6807\u7b7e\u8fb9\u754c\u7684\u5b50\u57df\u3002",
      "examples" : [ "DOMAIN-SUFFIX,example.com,proxy" ],
      "pattern" : "^(?:[Dd][Oo][Mm][Aa][Ii][Nn]-[Ss][Uu][Ff][Ff][Ii][Xx],(?=[A-Za-z0-9.-]{1,253}\\.?,)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?,[^,\\u0000-\\u001f\\u007f]+)(?![\\s\\S])",
      "title" : "DomainSuffixRule",
      "type" : "string"
    },
    "Duration" :
    {
      "description" : "\u6b63\u6574\u6570\u4e0e ms/s/m/h \u5355\u4f4d\uff0c\u4e0d\u63a5\u53d7 0\u3001\u8d1f\u6570\u3001\u5c0f\u6570\u6216\u65e0\u5355\u4f4d\uff1b\u6574\u6570\u6ea2\u51fa\u53ca\u5b57\u6bb5\u4e4b\u95f4\u7684\u5927\u5c0f\u5173\u7cfb\u7531\u8fd0\u884c\u65f6\u68c0\u67e5\u3002",
      "examples" : [ "500ms", "5s", "5m", "24h" ],
      "pattern" : "^(?:[1-9][0-9]*(?:ms|s|m|h))(?![\\s\\S])",
      "type" : "string"
    },
    "FRS" :
    {
      "additionalProperties" : false,
      "description" : "\u4ec5 FRS \u89c4\u5219\u6fc0\u6d3b\uff1bpath \u53ef\u7701\u7565\uff0curl \u4e3a\u7a7a\u65f6\u4e0d\u6267\u884c\u66f4\u65b0\u3002\u6587\u4ef6\u5b8c\u6574\u6027\u548c\u96c6\u5408\u5f15\u7528\u7531\u8fd0\u884c\u65f6\u6821\u9a8c\u3002",
      "properties" :
      {
        "auto-update" :
        {
          "default" : false,
          "description" : "\u542f\u52a8\u540e\u6309\u5468\u671f\u66f4\u65b0\u5b8c\u6574 .frs\uff1b\u5931\u8d25\u4fdd\u7559\u65e7 Runtime\u3002",
          "type" : "boolean"
        },
        "dns-server" :
        {
          "$ref" : "#/$defs/OptionalDNSName",
          "description" : "\u4e0b\u8f7d\u7aef\u70b9\u7684\u672c\u5730\u89e3\u6790\u5668\uff1b\u7a7a\u503c Bootstrap\uff0cDNS \u5173\u95ed\u65f6\u4f7f\u7528\u7cfb\u7edf\u89e3\u6790\u5668\u3002"
        },
        "path" :
        {
          "$ref" : "#/$defs/Path",
          "description" : "\u5355\u4e2a\u591a\u96c6\u5408 .frs \u6587\u4ef6\uff1b\u7701\u7565\u65f6\u4f7f\u7528 ftun \u53ef\u6267\u884c\u6587\u4ef6\u6240\u5728\u76ee\u5f55\u7684 rules.frs\u3002"
        },
        "update-interval" :
        {
          "$ref" : "#/$defs/Duration",
          "default" : "24h"
        },
        "update-outbound" :
        {
          "$ref" : "#/$defs/Name",
          "default" : "DIRECT"
        },
        "url" :
        {
          "anyOf" :
          [
            {
              "const" : ""
