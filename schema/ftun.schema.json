{
  "$comment" : "\u53c2\u8003 https://sing-box.sagernet.org/schema.json \u7684 Draft 2020-12\u3001$defs \u4e0e\u7c7b\u578b\u5206\u652f\u7ec4\u7ec7\uff1b\u5b57\u6bb5\u548c\u7ea6\u675f\u4f9d\u636e FTUN \u914d\u7f6e\u89c4\u8303\u72ec\u7acb\u7f16\u5199\u3002\u5c1a\u672a\u53d1\u5e03\u56fa\u5b9a\u8fdc\u7a0b URL\uff0c\u4e0d\u8bbe\u7f6e\u865a\u6784\u7684 $id\u3002",
