        "udp-associations" :
        {
          "default" : 256,
          "description" : "\u540c\u65f6\u5b58\u6d3b\u7684 SOCKS5 UDP \u5173\u8054\u4e0a\u9650\uff1b\u4ec5\u542f\u52a8\u65f6\u751f\u6548\u3002",
