            {
              "$ref" : "#/$defs/HTTPURL"
            }
          ],
          "default" : "",
          "description" : "HTTP(S) \u66f4\u65b0\u5730\u5740\uff1b\u7a7a\u503c\u4e0d\u66f4\u65b0\u5e76\u7531\u8fd0\u884c\u65f6\u544a\u8b66\u3002"
        }
      },
      "title" : "FTUN Rule Set",
      "type" : "object"
    },
    "FRSDomainRule" :
    {
      "description" : "\u6309\u533a\u5206\u5927\u5c0f\u5199\u7684 label \u5339\u914d .frs exact/suffix/keyword \u57df\u540d\u96c6\u5408\uff1b\u4e0d\u5929\u7136\u89e6\u53d1 DNS\u3002",
      "examples" : [ "FRS-DOMAIN,CN,proxy" ],
      "pattern" : "^(?:[Ff][Rr][Ss]-[Dd][Oo][Mm][Aa][Ii][Nn],[^,\\u0000-\\u001f\\u007f]+,[^,\\u0000-\\u001f\\u007f]+)(?![\\s\\S])",
      "title" : "FRSDomainRule",
      "type" : "string"
    },
    "FRSIPRule" :
    {
      "description" : "\u6309\u533a\u5206\u5927\u5c0f\u5199\u7684 label \u5339\u914d .frs IPv4 \u533a\u95f4\u96c6\u5408\uff1b\u5df2\u6709 IP \u4e0d\u9700\u8981 DNS\u3002",
