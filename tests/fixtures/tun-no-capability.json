{
  "base": {
    "state-cache": false
  },
  "log": {
    "level": "silent"
  },
  "dns": {
    "enable": false
  },
  "tun": {
    "interface": "ftun-no-cap0",
    "mtu": 1400,
    "ipv4": {
      "address": "10.79.0.1/30"
    },
    "auto-route": true,
    "strict-route": true
  },
  "inbounds": [
    {
      "name": "tun-no-capability",
      "type": "tun",
      "tcp": true,
      "udp": true,
      "dns-hijack": false
    }
  ],
  "rules": [
    "MATCH,DIRECT"
  ]
}
