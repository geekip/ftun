# 合并现有配置分段；所有引用在输出中保持为本地 $defs。
file(READ "${FTUN_SCHEMA_DIR}/app.schema.json" merged)
foreach(section core dns proxy)
  file(READ "${FTUN_SCHEMA_DIR}/${section}.schema.json" fragment)
  string(JSON root_count LENGTH "${fragment}")
  math(EXPR root_last "${root_count} - 1")
  foreach(root_index RANGE ${root_last})
    string(JSON key MEMBER "${fragment}" ${root_index})
    if(key STREQUAL "properties" OR key STREQUAL "$defs")
      string(JSON count LENGTH "${fragment}" "${key}")
      math(EXPR last "${count} - 1")
      foreach(index RANGE ${last})
        string(JSON name MEMBER "${fragment}" "${key}" ${index})
        string(JSON previous ERROR_VARIABLE missing TYPE "${merged}" "${key}" "${name}")
        if(missing STREQUAL "NOTFOUND")
          message(FATAL_ERROR "Duplicate schema entry: ${key}/${name}")
        endif()
        string(JSON value GET "${fragment}" "${key}" "${name}")
        string(JSON merged SET "${merged}" "${key}" "${name}" "${value}")
      endforeach()
    elseif(key STREQUAL "allOf")
      string(JSON previous ERROR_VARIABLE missing TYPE "${merged}" allOf)
      if(missing STREQUAL "NOTFOUND")
        message(FATAL_ERROR "Duplicate schema allOf")
      endif()
      string(JSON value GET "${fragment}" allOf)
      string(JSON merged SET "${merged}" allOf "${value}")
    else()
      message(FATAL_ERROR "Unsupported schema fragment key: ${key}")
    endif()
  endforeach()
endforeach()
# CMake 统一对象顺序和缩进，使构建产物与仓库中的发行文件可逐字比较。
string(JSON merged GET "${merged}")
string(REGEX REPLACE "[ \t]+\n" "\n" merged "${merged}")
if(FTUN_SCHEMA_CHECK)
  file(READ "${FTUN_SCHEMA_OUTPUT}" published)
  if(NOT published STREQUAL "${merged}\n")
    message(FATAL_ERROR "Generated schema is stale: run cmake -DFTUN_SCHEMA_DIR=<source>/schema -DFTUN_SCHEMA_OUTPUT=<source>/schema/ftun.schema.json -P tools/schema/merge.cmake")
  endif()
else()
  file(WRITE "${FTUN_SCHEMA_OUTPUT}" "${merged}\n")
endif()
