{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FTUN_OPTIMIZATION": "balanced",
        "FTUN_SANITIZERS": false,
        "FTUN_LTO": false,
        "FTUN_MODULE_DNS": "BUILTIN",
        "FTUN_MODULE_TUN": "BUILTIN",
        "FTUN_MODULE_FRS": "BUILTIN",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "sanitize",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FTUN_OPTIMIZATION": "balanced",
        "FTUN_SANITIZERS": true,
        "FTUN_LTO": false,
        "FTUN_MODULE_DNS": "BUILTIN",
        "FTUN_MODULE_TUN": "BUILTIN",
        "FTUN_MODULE_FRS": "BUILTIN",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FTUN_OPTIMIZATION": "balanced",
        "FTUN_SANITIZERS": false,
        "FTUN_LTO": false,
        "FTUN_MODULE_DNS": "BUILTIN",
        "FTUN_MODULE_TUN": "BUILTIN",
        "FTUN_MODULE_FRS": "BUILTIN",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "release-size",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release-size",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "FTUN_OPTIMIZATION": "size",
        "FTUN_SANITIZERS": false,
        "FTUN_LTO": false,
        "FTUN_MODULE_DNS": "BUILTIN",
        "FTUN_MODULE_TUN": "BUILTIN",
        "FTUN_MODULE_FRS": "BUILTIN",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "release-lto",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release-lto",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FTUN_OPTIMIZATION": "speed",
        "FTUN_SANITIZERS": false,
        "FTUN_LTO": true,
        "FTUN_MODULE_DNS": "BUILTIN",
        "FTUN_MODULE_TUN": "BUILTIN",
        "FTUN_MODULE_FRS": "BUILTIN",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "linux-x86_64-musl",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-x86_64-musl",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-x86_64-musl.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "FTUN_OPTIMIZATION": "size",
        "FTUN_STATIC": true,
        "FTUN_LTO": true,
        "FTUN_MODULE_DNS": "BUILTIN",
        "FTUN_MODULE_TUN": "BUILTIN",
        "FTUN_MODULE_FRS": "BUILTIN",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "release-size",
      "configurePreset": "release-size"
    },
    {
      "name": "release-lto",
      "configurePreset": "release-lto"
    },
    {
      "name": "linux-x86_64-musl",
      "configurePreset": "linux-x86_64-musl"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-size",
      "configurePreset": "release-size",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-lto",
      "configurePreset": "release-lto",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
